ext "UEFI" struct TableHeader {
	signature   UInt64,
	revision    UInt32,
	header_size UInt32,
	crc32       UInt32,
	reserved    UInt32
}

type Status = UInt64

type TextReset = ext "UEFI" fun (
	this: *SimpleTextOutputProtocol,
	extended_verification: Bool
) -> Status

type TextString = ext "UEFI" fun (
	this: *SimpleTextOutputProtocol,
	string: *Char16
) -> Status

type QueryMode = ext "UEFI" fun (
	this: *SimpleTextOutputProtocol,
	mode: UInt64,
	columns: *UInt64,
	rows: *UInt64
) -> Status

type SetMode = ext "UEFI" fun (
	this: *SimpleTextOutputProtocol,
	mode: UInt64
) -> Status

type SetAttribute = ext "UEFI" fun (
	this: *SimpleTextOutputProtocol,
	attribute: UInt64
) -> Status

type ClearScreen = ext "UEFI" fun (
	this: *SimpleTextOutputProtocol
) -> Status

type SetCursorPosition = ext "UEFI" fun (
	this: *SimpleTextOutputProtocol,
	columns: UInt64,
	rows: UInt64,
) -> Status

type EnableCursor = ext "UEFI" fun (
	this: *SimpleTextOutputProtocol,
	visible: Bool
) -> Status

ext "UEFI" struct SimpleTextOutputMode {
	max_mode       Int32,
	mode           Int32,
	attribute      Int32,
	cursor_column  Int32,
	cursor_row     Int32,
	cursor_visible Bool
}

ext "UEFI" struct SimpleTextOutputProtocol {
	reset TextReset,
	output_string TextString,
	test_string TextString,
	query_mode QueryMode,
	set_mode SetMode,
	set_attribute SetAttribute,
	clear_screen ClearScreen,
	set_cursor_position SetCursorPosition,
	enable_cursor EnableCursor,
	mode *SimpleTextOutputMode,
}

ext "UEFI" struct SystemTable {
	header                  TableHeader,
	firmware_vendor         *Char16,
	firmware_revision       UInt32,
	console_in_handle       *Void,
	con_in                  *Void, # set to *Void for now because we don't need it yet
	console_out_handle      *Void,
	con_out                 *SimpleTextOutputProtocol,
	stderr_handle           *Void,
	stderr                  *SimpleTextOutputProtocol,
	runtime_services        *Void, # set to *Void for now because we don't need it yet
	boot_services           *Void, # set to *Void for now because we don't need it yet
	number_of_table_entries UInt64,
	configuration_table     *Void  # set to *Void for now because we don't need it yet
}

fun panic(status : Status) -> ! {
	while true {}
}

ext "UEFI" fun efi_main(image_handle : *Void, system_table : *SystemTable) -> Status {
	status UInt64
	string []Char16 = "hello tenebre!\0"

	status = system_table.con_out.clear_screen(system_table.con_out)
	if status != 0 {
		panic(status)
	}

	status = system_table.con_out.output_string(system_table.con_out, string)
	if status != 0 {
		panic(status)
	}

	while true {}

	0
}
